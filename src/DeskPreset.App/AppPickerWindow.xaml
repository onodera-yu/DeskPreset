<Window x:Class="DeskPreset.App.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskPreset.App"
        Title="アプリを追加" Width="620" Height="640" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:AppIconConverter x:Key="AppIcon" />
        <DataTemplate x:Key="PickItem">
            <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Center" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="24" Height="24" Margin="0,0,10,0">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AppIcon}">
                                <Binding Path="ExePath" />
                                <Binding Path="AppId" />
                                <Binding Path="ViaAppId" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" Style="{StaticResource SectionTitle}" />
        <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,4,0,10" TextChanged="Search_TextChanged"
                 ToolTip="名前で絞り込み" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="追加" MinWidth="100" IsDefault="True" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="キャンセル" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="Items" ItemTemplate="{StaticResource PickItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" />
    </DockPanel>
</Window>
